{%- liquid
assign iso = request.locale.iso_code | downcase

case iso
when 'en'
assign klarna_locale = 'en-US'
when 'zh' or 'zh-cn'
assign klarna_locale = 'en-US'
when 'de'
assign klarna_locale = 'de-DE'
when 'fr'
assign klarna_locale = 'fr-FR'
when 'it'
assign klarna_locale = 'it-IT'
when 'es'
assign klarna_locale = 'es-ES'
when 'nl'
assign klarna_locale = 'nl-NL'
when 'at'
assign klarna_locale = 'de-AT'
else
if iso.size > 2
assign klarna_locale = iso
else
assign klarna_locale = 'en-US'
endif
endcase
-%}
<script>
  /**
   * Shopify optimization - Analytics & Inbox Friendly Version
   */
  (function () {

    window.fbq = function () { window.fbq.queue.push(arguments); };
    window.fbq.queue = [];
    window.fbq.version = '2.9.324';
    window.fbq.loaded = true;

    const UNWANTED = ['GTStandard', 'gravity-font-faces', 'shoplift'];
    const ASYNC_CSS = ['accelerated-checkout-backwards-compat.css'];
    const IS_CHECKOUT = window.location.pathname.includes('/checkouts');

    const processNode = (n) => {
      if (n.nodeType !== 1) return;
      const tag = n.tagName;
      if (tag !== 'LINK' && tag !== 'STYLE' && tag !== 'SCRIPT') return;

      const src = n.src || '';
      const text = n.textContent || '';

      if (/fbevents\.js|connect\.facebook\.net/i.test(src + text)) {
        n.remove();
        return;
      }

      // if (/goaffpro|googletagmanager|element-plus|jquery|hls\.js/i.test(src)) return;
      // if (src.includes('googletagmanager') || src.includes('google-analytics') || src.includes('ahrefs.com') || src.includes('goaffpro')) return;
      // if (tag === 'SCRIPT' && (text.includes('gtag') || text.includes('ahrefs') || text.includes('goaffpro'))) return;
      if (/goaffpro|ahrefs|element-plus|jquery|hls\.js|swiper/i.test(src + text)) {
        if (tag === 'SCRIPT' && n.src && !n.defer && !n.async) {
          if (!n.dataset.delayed) {
            n.dataset.delayed = 'true';
            n.defer = true;
            const parent = n.parentNode;
            if (parent) {
              const next = n.nextSibling;
              parent.removeChild(n);
              parent.insertBefore(n, next);
            }
          }
          return;
        }
      }

      if (tag === 'LINK' || tag === 'STYLE') {
        const href = n.getAttribute('href') || '';
        const content = href + text;

        if (UNWANTED.some(k => content.includes(k))) {
          n.remove();
          return;
        }

        if (!IS_CHECKOUT && tag === 'LINK' && ASYNC_CSS.some(k => href.includes(k))) {
          if (!n.dataset.optimized) {
            n.dataset.optimized = 'true';
            n.media = 'print';
            n.addEventListener('load', function () { this.media = 'all'; }, { once: true });
          }
        }
      }
    };

    const originalCreateElement = document.createElement;
    document.createElement = function (tag) {
      try {
        const element = originalCreateElement.call(document, tag);
        if (element && typeof tag === 'string' && tag.toLowerCase() === 'script') {
          Object.defineProperty(element, 'src', {
            set: function (url) {
              try {
                const urlStr = String(url || '');
                if (urlStr.includes('fbevents.js') || urlStr.includes('connect.facebook.net')) {
                  return;
                }
              } catch (innerErr) { }
              this.setAttribute('src', url);
            },
            get: function () {
              return this.getAttribute('src') || '';
            },
            configurable: true,
            enumerable: true
          });
        }
        return element;
      } catch (err) {
        return originalCreateElement.call(document, tag);
      }
    };

    const originalFetch = window.fetch;
    if (typeof originalFetch === 'function') {
      window.fetch = function (input, init) {
        try {
          const url = typeof input === 'string' ? input : (input && input.url ? String(input.url) : '');
          if (url && (/fbevents\.js|connect\.facebook\.net|get_fb_pixel/i.test(url))) {
            return Promise.resolve(new Response(JSON.stringify({}), { status: 200, headers: { 'Content-Type': 'application/json' } }));
          }
        } catch (err) { }
        return originalFetch.call(window, input, init);
      };
    }

    try {
      document.querySelectorAll('link, style, script').forEach(processNode);
    } catch (err) { }

    const observer = new MutationObserver(mutations => {
      for (let i = 0; i < mutations.length; i++) {
        if (mutations[i].addedNodes) {
          mutations[i].addedNodes.forEach(processNode);
        }
      }
    });

    const fixKlarnaLocale = () => {
      try {
        const _rawWarn = console.warn;
        if (typeof _rawWarn === 'function' && !_rawWarn.__wrapped) {
          console.warn = function (...args) {
            try {
              if (args && args[0] && typeof args[0] === 'string') {
                if (args[0].includes('Klarna') && args[0].includes('locale')) return;
              }
            } catch (innerE) { }
            return Reflect.apply(_rawWarn, console, args);
          };
          console.warn.__wrapped = true; 
        }
      } catch (e) { }

      try {
        const locale = '{{ klarna_locale }}';
        const kKey = 'klarna-web-sdk-config';
        const cached = sessionStorage.getItem(kKey);
        let cfg = cached ? JSON.parse(cached) : {};
        if (cfg.locale !== locale) {
          cfg.locale = locale;
          sessionStorage.setItem(kKey, JSON.stringify(cfg));
        }
        window.KlarnaConfig = { ...window.KlarnaConfig, locale };
      } catch (e) { }
    };
    if (!IS_CHECKOUT) fixKlarnaLocale();

    const target = document.head || document.documentElement;
    observer.observe(target, { childList: true, subtree: true });
    setTimeout(() => observer.disconnect(), 5000);

    if (!IS_CHECKOUT) {
      const INBOX_CFG = { events: ['touchstart', 'scroll', 'click'], left: '20px', delay: 6000 };
      const s = document.createElement('style');
      s.textContent = `
        #ShopifyChatContainer, .shopify-chat, iframe#shopify-chat-app { left: ${INBOX_CFG.left} !important; right: auto !important; visibility: hidden !important; pointer-events: none !important; opacity: 0 !important; transition: opacity 0.3s; } 
        .inbox-activated #ShopifyChatContainer, .inbox-activated .shopify-chat, .inbox-activated iframe#shopify-chat-app { visibility: visible !important; pointer-events: auto !important; opacity: 1 !important; }
      `;
      document.head.appendChild(s);

      let activated = false;
      const activateInbox = () => {
        if (activated) return;
        activated = true;
        document.documentElement.classList.add('inbox-activated');
        INBOX_CFG.events.forEach(e => window.removeEventListener(e, activateInbox));
        const initChat = (c) => {
          try { if (c && c.load) c.load(); else if (c && c.init) c.init(); if (c && c.show) c.show(); } catch (e) { }
        };
        if (window.ShopifyChat) { initChat(window.ShopifyChat); } else {
          let chatTemp = null;
          Object.defineProperty(window, 'ShopifyChat', { configurable: true, enumerable: true, get: () => chatTemp, set: (v) => { chatTemp = v; if (v) initChat(v); } });
        }
      };
      INBOX_CFG.events.forEach(e => window.addEventListener(e, activateInbox, { passive: true, once: true }));
      setTimeout(activateInbox, INBOX_CFG.delay);
    }
  })();
</script>
